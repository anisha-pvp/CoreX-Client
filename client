(function () {
  "use strict";
  const registry = window.__anishaModules;
  const game = window.__anishaState || {};
  if (!registry) return;

  const STORAGE = "corex-state-v1";
  const modes = {
    "Kill Aura":"Packets", Aimbot:"Legit", "Auto Trigger":"Legit", "Magic Bullet":"Packets",
    "Auto Drink":"Vanilla", "Trap Aura":"Vanilla", Scaffold:"Vanilla", Bhop:"Vanilla",
    "No Slow":"Vanilla", "Auto Sprint":"Legit", "Ground Builder":"Vanilla", Discord:"Utility",
    Website:"Utility", "Tracer Lines":"Visual", ESP:"Visual", "Nametag Display":"Visual",
    "No FOV":"Vanilla", "Player Coordinates":"Utility", "Night Mode":"Visual", Animation:"Vanilla",
    "Item Spin":"Vanilla", Derp:"Vanilla", "X-Ray":"Visual", "Target HUD":"Visual",
    "Item Range":"Vanilla", "Fast Place":"Packets", "Fast Break":"Packets", "Bed Aura":"Packets",
    "Glider Boost":"Vanilla", "Inventory Manager":"Vanilla",
    "New Account":"Utility", OreESP:"Visual", "HUD Editor":"Utility", Blur:"Visual",
    Watermark:"Visual", "Module List":"Visual", "FPS/Ping":"Utility", Keystrokes:"Utility"
  };

  function load() { try { return JSON.parse(localStorage.getItem(STORAGE) || "{}"); } catch { return {}; } }
  let saveTimer = null;
  function save() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      const data = {};
      Object.values(registry).filter(Boolean).forEach(m => {
        data[m.name] = { enabled: !!m.enabled, settings: {} };
        Object.entries(m.settings || {}).forEach(([k, s]) => data[m.name].settings[k] = s.value);
      });
      localStorage.setItem(STORAGE, JSON.stringify(data));
    }, 350);
  }
  function installPersistence() {
    Object.values(registry).filter(Boolean).forEach(m => {
      if (m.__corexPersisted) return;
      m.__corexPersisted = true;
      const oldToggle = typeof m.toggle === "function" ? m.toggle.bind(m) : null;
      if (oldToggle) m.toggle = function (...args) { const result = oldToggle(...args); save(); return result; };
      Object.values(m.settings || {}).forEach(s => {
        const oldChange = s.onChange;
        s.onChange = value => { oldChange?.(value); save(); };
      });
    });
  }

  const chestStealer = {
    name: "Chest Stealer", category: "World", enabled: false, type: "toggle", swapOps: null, _raf: null,
    getWrapper() {
      try {
        const impKey = game.impKey, entity = game.noa?.entities?.[impKey];
        if (!impKey || !entity) return null;
        for (const key in entity) {
          const val = entity[key], wrapper = val?.list?.[0]?.opWrapper;
          if (wrapper?.playerInventory) return wrapper;
        }
        return Object.values(entity).find(val => val?.playerInventory?.items && (typeof val.swapPosClient === "function" || typeof val.swapPos === "function")) || null;
      } catch { return null; }
    },
    getSwapOperation() {
      if (this.swapOps) return this.swapOps;
      const wrapper = this.getWrapper();
      if (wrapper && typeof wrapper.swapPosClient === "function") this.swapOps = wrapper;
      return this.swapOps;
    },
    swapToSlot(wrapper, fromSlot, toSlot) {
      try {
        if (typeof wrapper?.swapPosClient === "function") { wrapper.swapPosClient(wrapper, fromSlot, toSlot); return true; }
        const op = this.getSwapOperation();
        if (typeof op?.swapPosClient === "function") { op.swapPosClient(wrapper, fromSlot, toSlot); return true; }
        if (typeof wrapper?.swapPos === "function") { wrapper.swapPos(fromSlot, toSlot); return true; }
      } catch {}
      return false;
    },
    moveItems(wrapper, fromSlot, toSlot, amount) {
      try {
        if (typeof wrapper?.moveItemIntoIdxsClient === "function") { wrapper.moveItemIntoIdxsClient(wrapper, toSlot, toSlot + 1, fromSlot, amount); return true; }
        return this.swapToSlot(wrapper, fromSlot, toSlot);
      } catch { return false; }
    },
    tick() {
      const wrapper = this.getWrapper();
      if (!wrapper?.playerInventory?.items) return;
      let chestInv = null;
      for (const val of Object.values(wrapper)) {
        if (val && val !== wrapper.playerInventory && Array.isArray(val.items) && val.numSlots !== undefined) { chestInv = val; break; }
      }
      if (!chestInv?.items) return;
      const inv = wrapper.playerInventory.items;
      chestInv.items.forEach((item, chestIdx) => {
        if (!item) return;
        let left = item.amount ?? 1;
        const max = item.typeObj?.maxStack || 999;
        if (item.typeObj?.stackable !== false) for (let i = 0; i < 46 && left > 0; i++) {
          const target = inv[i];
          if (target?.name === item.name && target.amount < max) { const amount = Math.min(max - target.amount, left); if (this.moveItems(wrapper, 51 + chestIdx, i, amount)) left -= amount; }
        }
        if (left > 0) for (let i = 0; i < 46; i++) if (!inv[i] && this.swapToSlot(wrapper, 51 + chestIdx, i)) break;
      });
    },
    onEnable() {
      if (this._raf) return;
      const loop = () => { if (!this.enabled) { this._raf = null; return; } try { this.tick(); } catch {} this._raf = requestAnimationFrame(loop); };
      this._raf = requestAnimationFrame(loop);
    },
    onDisable() { if (this._raf) cancelAnimationFrame(this._raf); this._raf = null; this.swapOps = null; },
    toggle() { this.enabled = !this.enabled; if (this.enabled) this.onEnable(); else this.onDisable(); save(); }
  };
  if (!registry["Chest Stealer"]) registry["Chest Stealer"] = chestStealer;

  installPersistence();
  const desired = load();
  let restored = false;
  const restore = () => {
    if (restored && !game.injected) return;
    installPersistence();
    Object.values(registry).filter(Boolean).forEach(m => {
      const saved = desired[m.name];
      if (saved?.settings) Object.entries(saved.settings).forEach(([k, v]) => { if (m.settings?.[k]) m.settings[k].value = v; });
      if (saved && saved.enabled && !m.enabled && game.injected) m.toggle(true);
    });
    restored = true;
  };
  restore();
  let lastArraySignature = "";
  const renderStableArray = () => {
    const active = Object.values(registry).filter(m => m?.enabled && m.category !== "HUD").sort((a,b) => b.name.length - a.name.length);
    const signature = active.map(m => `${m.name}:${modes[m.name] || "Vanilla"}`).join("|");
    const array = document.querySelector("#anisha-client-v2 .ac2-array");
    if (!array || signature === lastArraySignature) return;
    lastArraySignature = signature;
    array.replaceChildren(...active.map(m => {
      const item = document.createElement("div"); item.className = "ac2-arrayitem";
      item.textContent = m.name;
      const mode = document.createElement("span"); mode.className = "ac2-arraymode"; mode.textContent = modes[m.name] || "Vanilla";
      item.appendChild(mode); item.style.setProperty("--h", String((m.name.length * 37) % 360)); return item;
    }));
    array.style.display = active.length ? "flex" : "none";
  };
  setInterval(() => { restore(); renderStableArray(); }, 250);
})();

