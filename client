    const order = sortOrders[activeCategory] || [];
    const list = allModules()
      .filter(
        (m) =>
          m.category === requestedCategory &&
          (!query || m.name.toLowerCase().includes(query)),
      )
      .sort((a, b) => {
        const ai = order.indexOf(a.name),
          bi = order.indexOf(b.name);
        if (ai !== -1 || bi !== -1)
          return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
        return a.name.localeCompare(b.name);
      });
    title.innerHTML = `${esc(activeCategory)} <span class="ac2-count">${list.length} MODULES</span>`;
    grid.innerHTML = "";
    if (!list.length) {
      grid.innerHTML = `<div class="ac2-card"><div class="ac2-mode">No modules in this category.</div></div>`;
      return;
    }
    list.forEach((module) => {
      const card = document.createElement("div");
      card.className = "ac2-card";
      const top = document.createElement("div");
      top.className = "ac2-cardtop";
      const text = document.createElement("div");
      text.innerHTML = `<div class="ac2-name">${esc(module.name)}</div><div class="ac2-mode">${esc(description(module))}</div>`;
      const gear = document.createElement("div");
      gear.className = "ac2-gear";
      gear.textContent = "⚙";
      gear.style.visibility =
        module.settings && Object.keys(module.settings).length
          ? "visible"
          : "hidden";
      gear.addEventListener("click", (e) => {
        e.stopPropagation();
        openSettings(module);
      });
      top.append(text, gear);
      const bottom = document.createElement("div");
      bottom.className = "ac2-bottom";
      const bind = document.createElement("div");
      bind.className = "ac2-bind";
      bind.textContent = `[ ${module.key ? module.key.replace(/^Key/, "") : "NONE"} ]`;
      bind.addEventListener("click", (e) => {
        e.stopPropagation();
        bindingModule = module;
      });
      const toggle = document.createElement("div");
      toggle.className = "ac2-toggle" + (module.enabled ? " on" : "");
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleModule(module);
      });
      bottom.append(bind, toggle);
      card.append(top, bottom);
      card.addEventListener("click", () =>
        module.settings ? openSettings(module) : toggleModule(module),
      );
      card.addEventListener("contextmenu", (e) => {
        e.preventDefault();
        bindingModule = module;
      });
      grid.appendChild(card);
    });
  }

  const creditsPanel = root.querySelector(".ac2-credits");
  const configPanel = root.querySelector(".ac2-config");
  const showSection = (section) => {
    grid.style.display = section === "modules" ? "grid" : "none";
    configPanel.style.display = section === "config" ? "block" : "none";
    creditsPanel.style.display = section === "credits" ? "block" : "none";
  };
  root.querySelectorAll(".ac2-cat").forEach((button) =>
    button.addEventListener("click", () => {
      activeCategory = button.dataset.category || button.textContent.trim();
      root
        .querySelectorAll(".ac2-cat")
        .forEach((b) => b.classList.toggle("active", b === button));
      if (activeCategory === "Config") {
        showSection("config");
        return;
      }
      if (activeCategory === "Credits") {
        showSection("credits");
        return;
      }
      showSection("modules");
      render();
    }),
  );
  search.addEventListener("input", render);
  root
    .querySelector(".ac2-back")
    .addEventListener("click", () => settings.classList.remove("demo"));
  root.querySelector(".ac2-close").addEventListener("click", () => {
    win.style.display = "none";
  });
  root
    .querySelector(".ac2-account")
    .addEventListener("click", () => modules["New Account"]?.onEnable?.());
  injectButton.addEventListener("click", () => {
    updateStatus();
    render();
  });
  root.querySelectorAll(".ac2-config-btn").forEach((button) =>
    button.addEventListener("click", () => {
      const action = button.textContent.trim();
      if (action === "RESET")
        allModules().forEach((m) => {
          if (m.enabled) m.toggle();
        });
      if (action === "SAVE")
        localStorage.setItem(
          "anisha-client-config",
          JSON.stringify(
            allModules().map((m) => ({ name: m.name, enabled: m.enabled })),
          ),
        );
      if (action === "LOAD") {
        try {
          JSON.parse(
            localStorage.getItem("anisha-client-config") || "[]",
          ).forEach((s) => {
            const m = modules[s.name];
            if (m && !!s.enabled !== m.enabled) m.toggle();
          });
        } catch {}
      }
      render();
      updateArray();
    }),
  );

  root.querySelectorAll(".ac2-cat").forEach((button) => {
    if (
      !categories.includes(button.dataset.category || button.textContent.trim())
    )
      button.style.display = "none";
  });

  window.addEventListener(
    "keydown",
    (e) => {
      if (bindingModule) {
        e.preventDefault();
        bindingModule.key = ["Escape", "Delete"].includes(e.code)
          ? null
          : e.code;
        bindingModule = null;
        render();
        return;
      }
      if (!e.repeat && e.code === "ShiftRight") {
        win.style.display = win.style.display === "none" ? "flex" : "none";
      }
      allModules().forEach((m) => {
        if (m.key === e.code) toggleModule(m);
      });
    },
    true,
  );
  updateStatus();
  updateStatus();
  updateArray();
  render();
})();

(function () {
  "use strict";
  const registry = window.__anishaModules;
  const game = window.__anishaState || {};
  if (!registry || registry["Chest Stealer"]) return;

  const STORAGE = "anisha-client-state-v2";
  const modes = {
    "Kill Aura": "Packets",
    Aimbot: "Legit",
    "Auto Trigger": "Legit",
    "Magic Bullet": "Packets",
    "Auto Drink": "Vanilla",
    "Trap Aura": "Vanilla",
    Scaffold: "Vanilla",
    Bhop: "Vanilla",
    "No Slow": "Vanilla",
    "Auto Sprint": "Legit",
    "Ground Builder": "Vanilla",
    Discord: "Utility",
    Website: "Utility",
    "Tracer Lines": "Visual",
    ESP: "Visual",
    "Nametag Display": "Visual",
    "No FOV": "Vanilla",
    "Player Coordinates": "Utility",
    "Night Mode": "Visual",
    Animation: "Vanilla",
    "Item Spin": "Vanilla",
    Derp: "Vanilla",
    "X-Ray": "Visual",
    "Target HUD": "Visual",
    "Item Range": "Vanilla",
    "Fast Place": "Packets",
    "Fast Break": "Packets",
    "Bed Aura": "Packets",
    "Glider Boost": "Vanilla",
    "Loot Chests": "Vanilla",
    "Inventory Manager": "Vanilla",
    "New Account": "Utility",
    OreESP: "Visual",
    "HUD Editor": "Utility",
    Blur: "Visual",
    Watermark: "Visual",
    "Module List": "Visual",
    "FPS/Ping": "Utility",
    Keystrokes: "Utility",
    Theme: "Visual",
  };

  function load() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE) || "{}");
    } catch {
      return {};
    }
  }
  let saveTimer = null;
  function save() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      const data = {};
      Object.values(registry)
        .filter(Boolean)
        .forEach((m) => {
          data[m.name] = { enabled: !!m.enabled, settings: {} };
          Object.entries(m.settings || {}).forEach(
            ([k, s]) => (data[m.name].settings[k] = s.value),
          );
        });
      localStorage.setItem(STORAGE, JSON.stringify(data));
    }, 350);
  }
  function installPersistence() {
    Object.values(registry)
      .filter(Boolean)
      .forEach((m) => {
        if (m.__anishaPersisted) return;
        m.__anishaPersisted = true;
        const oldToggle =
          typeof m.toggle === "function" ? m.toggle.bind(m) : null;
        if (oldToggle)
          m.toggle = function (...args) {
            const result = oldToggle(...args);
            save();
            return result;
          };
        Object.values(m.settings || {}).forEach((s) => {
          const oldChange = s.onChange;
          s.onChange = (value) => {
            oldChange?.(value);
            save();
          };
        });
      });
  }

  const chestStealer = {
    name: "Chest Stealer",
    category: "World",
    enabled: false,
    type: "toggle",
    swapOps: null,
    _raf: null,
    getWrapper() {
      try {
        const impKey = game.impKey,
          entity = game.noa?.entities?.[impKey];
        if (!impKey || !entity) return null;
        for (const key in entity) {
          const val = entity[key],
            wrapper = val?.list?.[0]?.opWrapper;
          if (wrapper?.playerInventory) return wrapper;
        }
        return (
          Object.values(entity).find(
            (val) =>
              val?.playerInventory?.items &&
              (typeof val.swapPosClient === "function" ||
                typeof val.swapPos === "function"),
          ) || null
        );
      } catch {
        return null;
      }
    },
    getSwapOperation() {
      if (this.swapOps) return this.swapOps;
      const wrapper = this.getWrapper();
      if (wrapper && typeof wrapper.swapPosClient === "function")
        this.swapOps = wrapper;
      return this.swapOps;
    },
    swapToSlot(wrapper, fromSlot, toSlot) {
      try {
        if (typeof wrapper?.swapPosClient === "function") {
          wrapper.swapPosClient(wrapper, fromSlot, toSlot);
          return true;
        }
        const op = this.getSwapOperation();
        if (typeof op?.swapPosClient === "function") {
          op.swapPosClient(wrapper, fromSlot, toSlot);
          return true;
        }
        if (typeof wrapper?.swapPos === "function") {
          wrapper.swapPos(fromSlot, toSlot);
          return true;
        }
      } catch {}
      return false;
    },
    moveItems(wrapper, fromSlot, toSlot, amount) {
      try {
        if (typeof wrapper?.moveItemIntoIdxsClient === "function") {
          wrapper.moveItemIntoIdxsClient(
            wrapper,
            toSlot,
            toSlot + 1,
            fromSlot,
            amount,
          );
          return true;
        }
        return this.swapToSlot(wrapper, fromSlot, toSlot);
      } catch {
        return false;
      }
    },
    tick() {
      const wrapper = this.getWrapper();
      if (!wrapper?.playerInventory?.items) return;
      let chestInv = null;
      for (const val of Object.values(wrapper)) {
        if (
          val &&
          val !== wrapper.playerInventory &&
          Array.isArray(val.items) &&
          val.numSlots !== undefined
        ) {
          chestInv = val;
          break;
        }
      }
      if (!chestInv?.items) return;
      const inv = wrapper.playerInventory.items;
      chestInv.items.forEach((item, chestIdx) => {
        if (!item) return;
        let left = item.amount ?? 1;
        const max = item.typeObj?.maxStack || 999;
        if (item.typeObj?.stackable !== false)
          for (let i = 0; i < 46 && left > 0; i++) {
            const target = inv[i];
            if (target?.name === item.name && target.amount < max) {
              const amount = Math.min(max - target.amount, left);
              if (this.moveItems(wrapper, 51 + chestIdx, i, amount))
                left -= amount;
            }
          }
        if (left > 0)
          for (let i = 0; i < 46; i++)
            if (!inv[i] && this.swapToSlot(wrapper, 51 + chestIdx, i)) break;
      });
    },
    onEnable() {
      if (this._raf) return;
      const loop = () => {
        if (!this.enabled) {
          this._raf = null;
          return;
        }
        try {
          this.tick();
        } catch {}
        this._raf = requestAnimationFrame(loop);
      };
      this._raf = requestAnimationFrame(loop);
    },
    onDisable() {
      if (this._raf) cancelAnimationFrame(this._raf);
      this._raf = null;
      this.swapOps = null;
    },
    toggle() {
      this.enabled = !this.enabled;
      if (this.enabled) this.onEnable();
      else this.onDisable();
      save();
    },
  };
  registry["Chest Stealer"] = chestStealer;

  installPersistence();
  const desired = load();
  let restored = false;
  const restore = () => {
    if (restored && !game.injected) return;
    installPersistence();
    Object.values(registry)
      .filter(Boolean)
      .forEach((m) => {
        const saved = desired[m.name];
        if (saved?.settings)
          Object.entries(saved.settings).forEach(([k, v]) => {
            if (m.settings?.[k]) m.settings[k].value = v;
          });
        if (saved && saved.enabled && !m.enabled && game.injected)
          m.toggle(true);
      });
    restored = true;
  };
  restore();
  let lastArraySignature = "";
  const renderStableArray = () => {
    const active = Object.values(registry)
      .filter((m) => m?.enabled && m.category !== "HUD")
      .sort((a, b) => b.name.length - a.name.length);
    const signature = active
      .map((m) => `${m.name}:${modes[m.name] || "Vanilla"}`)
      .join("|");
    const array = document.querySelector("#anisha-client-v2 .ac2-array");
    if (!array || signature === lastArraySignature) return;
    lastArraySignature = signature;
    array.replaceChildren(
      ...active.map((m) => {
        const item = document.createElement("div");
        item.className = "ac2-arrayitem";
        item.textContent = m.name;
        const mode = document.createElement("span");
        mode.className = "ac2-arraymode";
        mode.textContent = modes[m.name] || "Vanilla";
        item.appendChild(mode);
        item.style.setProperty("--h", String((m.name.length * 37) % 360));
        return item;
      }),
    );
    array.style.display = active.length ? "flex" : "none";
  };
  setInterval(() => {
    restore();
    renderStableArray();
  }, 250);
})();

/* Persist the replacement UI's configuration buttons using the same store. */
(function () {
  const key = "anisha-client-state-v2";
  document.addEventListener("click", (e) => {
    const button = e.target.closest?.(".ac2-config-btn");
    if (!button || !window.__anishaModules) return;
    if (button.textContent.trim() === "EXPORT") {
      const blob = new Blob([localStorage.getItem(key) || "{}"], {
        type: "application/json",
      });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "anisha-config.json";
      a.click();
    }
  });
})();

