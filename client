`;
  document.body.appendChild(root);

  if (legacy && legacy.shadowHost) legacy.shadowHost.style.display = "none";

  const win = root.querySelector(".ac2-window");
  const grid = root.querySelector(".ac2-grid");
  const title = root.querySelector(".ac2-title");
  const search = root.querySelector(".ac2-search");
  const settings = root.querySelector(".ac2-settings");
  const settingsTitle = root.querySelector(".ac2-settings-title");
  const settingsList = root.querySelector(".ac2-settings-list");
  const array = root.querySelector(".ac2-array");
  const status = root.querySelector(".ac2-inject-status");
  const injectButton = root.querySelector(".ac2-inject");
  let activeCategory = "Combat";
  let bindingModule = null;

  const categories = ["Combat", "Movement", "World", "Visual", "Config", "Credits"];
  const categoryMap = { Visual: "Visuals" };
  const allModules = () => Object.values(modules).filter(Boolean).filter(m => !["Website", "Discord"].includes(m.name));
  const moduleCategory = m => m.category === "Visuals" ? "Visual" : m.category;
  const esc = value => String(value ?? "").replace(/[&<>\"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));

  function description(m) {
    const descriptions = {
      "Kill Aura":"Automatically attacks nearby targets.", Aimbot:"Assists with aiming at targets.",
      "Fast Place":"Reduces block placement delay.", "Fast Break":"Reduces block breaking delay.",
      Watermark:"Shows the client watermark.", "Module List":"Shows enabled modules on screen.",
      "FPS/Ping":"Shows FPS and ping information.", Keystrokes:"Shows movement keys and CPS."
    };
    return descriptions[m.name] || `${m.category} module.`;
  }

  function updateStatus() {
    const injected = !!state.injected;
    status.classList.toggle("ready", injected);
    status.innerHTML = `<i></i> ${injected ? "INJECTED" : "READY"}`;
  }

  function updateArray() {
    array.innerHTML = "";
    const enabled = allModules().filter(m => m.enabled && m.category !== "HUD");
    enabled.sort((a,b) => b.name.length - a.name.length).forEach(m => {
      const item = document.createElement("div");
      item.className = "ac2-arrayitem";
      item.textContent = m.name;
      item.style.setProperty("--h", String((m.name.length * 37) % 360));
      array.appendChild(item);
    });
    array.style.display = enabled.length ? "flex" : "none";
  }

  function renderSetting(container, name, setting) {
    const row = document.createElement("div"); row.className = "ac2-setting";
    const label = document.createElement("div"); label.className = "ac2-setting-name"; label.textContent = name;
    if (setting.type === "slider") {
      const input = document.createElement("input"); input.className = "ac2-setting-input"; input.type = "number";
      input.min = setting.min; input.max = setting.max; input.step = setting.step || 1; input.value = setting.value;
      input.addEventListener("change", () => { setting.value = parseFloat(input.value); setting.onChange?.(setting.value); });
      row.append(label, input);
    } else if (setting.type === "checkbox") {
      const toggle = document.createElement("div"); toggle.className = "ac2-check" + (setting.value ? " on" : "");
      toggle.addEventListener("click", () => { setting.value = !setting.value; toggle.classList.toggle("on", setting.value); setting.onChange?.(setting.value); });
      row.append(label, toggle);
    } else if (setting.type === "dropdown") {
      const select = document.createElement("select"); select.className = "ac2-setting-input";
      (setting.options || []).forEach(option => { const o = new Option(option, option); o.selected = option === setting.value; select.add(o); });
      select.addEventListener("change", () => { setting.value = select.value; setting.onChange?.(setting.value); });
      row.append(label, select);
    } else {
      row.append(label);
    }
    container.appendChild(row);
  }

  function openSettings(module) {
    settingsTitle.textContent = `${module.name} Settings`;
    settingsList.innerHTML = "";
    Object.entries(module.settings || {}).forEach(([name, setting]) => renderSetting(settingsList, name, setting));
    settings.classList.add("demo");
    settings.dataset.module = module.name;
  }

  function toggleModule(module) {
    if (bindingModule) return;
    if (module.type === "action") { module.onEnable?.(); return; }
    module.toggle(); render(); updateArray();
  }

  function render() {
    const requestedCategory = categoryMap[activeCategory] || activeCategory;
    const query = (search.value || "").trim().toLowerCase();
    const list = allModules().filter(m => m.category === requestedCategory && (!query || m.name.toLowerCase().includes(query)));
    title.innerHTML = `${esc(activeCategory)} <span class="ac2-count">${list.length} MODULES</span>`;
    grid.innerHTML = "";
    if (!list.length) { grid.innerHTML = `<div class="ac2-card"><div class="ac2-mode">No modules in this category.</div></div>`; return; }
    list.forEach(module => {
      const card = document.createElement("div"); card.className = "ac2-card";
      const top = document.createElement("div"); top.className = "ac2-cardtop";
      const text = document.createElement("div"); text.innerHTML = `<div class="ac2-name">${esc(module.name)}</div><div class="ac2-mode">${esc(description(module))}</div>`;
      const gear = document.createElement("div"); gear.className = "ac2-gear"; gear.textContent = "⚙";
      gear.style.visibility = module.settings && Object.keys(module.settings).length > 0 ? "visible" : "hidden";
      gear.addEventListener("click", e => { e.stopPropagation(); openSettings(module); });
      top.append(text, gear);
      const bottom = document.createElement("div"); bottom.className = "ac2-bottom";
      const bind = document.createElement("div"); bind.className = "ac2-bind"; bind.textContent = `[ ${module.key ? module.key.replace(/^Key/, "") : "NONE"} ]`;
      bind.addEventListener("click", e => { e.stopPropagation(); bindingModule = module; });
      const toggle = document.createElement("div"); toggle.className = "ac2-toggle" + (module.enabled ? " on" : "");
      toggle.addEventListener("click", e => { e.stopPropagation(); toggleModule(module); });
      bottom.append(bind, toggle); card.append(top, bottom);
      card.addEventListener("click", () => module.settings && Object.keys(module.settings).length > 0 ? openSettings(module) : toggleModule(module));
      card.addEventListener("contextmenu", e => { e.preventDefault(); bindingModule = module; });
      grid.appendChild(card);
    });
  }

  const creditsPanel = root.querySelector(".ac2-credits");
  const configPanel = root.querySelector(".ac2-config");
  const showSection = section => {
    grid.style.display = section === "modules" ? "grid" : "none";
    configPanel.style.display = section === "config" ? "block" : "none";
    creditsPanel.style.display = section === "credits" ? "block" : "none";
  };
  root.querySelectorAll(".ac2-cat").forEach(button => button.addEventListener("click", () => {
    activeCategory = button.dataset.category || button.textContent.trim();
    root.querySelectorAll(".ac2-cat").forEach(b => b.classList.toggle("active", b === button));
    if (activeCategory === "Config") { showSection("config"); return; }
    if (activeCategory === "Credits") { showSection("credits"); return; }
    showSection("modules"); render();
  }));
  search.addEventListener("input", render);
  root.querySelector(".ac2-back").addEventListener("click", () => settings.classList.remove("demo"));
  root.querySelector(".ac2-close").addEventListener("click", () => { win.style.display = "none"; });
  root.querySelector(".ac2-account").addEventListener("click", () => modules["New Account"]?.onEnable?.());

  injectButton.addEventListener("click", () => {
    if (window.__injectAnisha) {
      const success = window.__injectAnisha();
      if (success) {
        Object.values(modules).forEach(m => {
          if (m.enabled && m.onEnable) m.onEnable();
        });
      }
    }
    updateStatus();
    render();
    updateArray();
  });

  root.querySelectorAll(".ac2-config-btn").forEach(button => button.addEventListener("click", () => {
    const action = button.textContent.trim();
    if (action === "RESET") allModules().forEach(m => { if (m.enabled) m.toggle(); });
    if (action === "SAVE") localStorage.setItem("corex-config", JSON.stringify(allModules().map(m => ({name:m.name,enabled:m.enabled}))));
    if (action === "LOAD") { try { JSON.parse(localStorage.getItem("corex-config") || "[]").forEach(s => { const m=modules[s.name]; if(m && !!s.enabled !== m.enabled) m.toggle(); }); } catch {} }
    render(); updateArray();
  }));

  root.querySelectorAll(".ac2-cat").forEach(button => {
    if (!categories.includes(button.dataset.category || button.textContent.trim())) button.style.display = "none";
  });

  window.addEventListener("keydown", e => {
    if (bindingModule) { e.preventDefault(); bindingModule.key = ["Escape","Delete"].includes(e.code) ? null : e.code; bindingModule = null; render(); return; }
    if (!e.repeat && e.code === "ShiftRight") { win.style.display = win.style.display === "none" ? "flex" : "none"; }
    allModules().forEach(m => { if (m.key === e.code) toggleModule(m); });
  }, true);
  setInterval(() => { updateStatus(); updateArray(); }, 500);
  updateStatus(); updateArray(); render();
})();

